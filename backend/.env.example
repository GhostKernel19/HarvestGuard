# HarvestGuard Backend Environment Configuration
PORT=8000
HOST=0.0.0.0

# Allowed frontend origin(s) for CORS. Can be comma-separated or wildcard for testing:
# e.g., https://harvestguard.vercel.app,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Path to compiled QNN model binary (optional; falls back to rule-based explainer if absent)
MODEL_PATH=../models/qwen3_1.7b_qnn.bin
